PRACTICAL 8 – SLIDING WINDOW PROTOCOL SIMULATION (GO-BACK-N)

Aim: To simulate the Go-Back-N sliding window protocol and display the frames sent and acknowledgements received.
Program – slidingwindow.c
#include <stdio.h>
#define MAX_FRAMES 50

void receiver(int frames[], int start, int window_size)
{
    for (int i = start; i < start + window_size; i++)
        printf("Received frame: %d, sending ACK: %d\n",
               frames[i], frames[i] + 1);
}

void sender(int frames[], int n, int window_size)
{
    int base = 0;
    char choice;

    while (base < n) {
        printf("\nSender window: ");
        for (int i = base; i < base + window_size && i < n; i++)
            printf("[%d] ", frames[i]);

        printf("\nSending frames...\n");
        for (int i = base; i < base + window_size && i < n; i++)
            printf("Sent frame: %d\n", frames[i]);

        printf("\nSimulating receiver...\n");
        int count = (base + window_size > n) ? n - base : window_size;
        receiver(frames, base, count);

        printf("\nDid all frames receive correctly? (y/n): ");
        scanf(" %c", &choice);

        if (choice == 'y' || choice == 'Y')
            base += window_size;
        else
            printf("Resending from frame %d...\n", frames[base]);
    }
    printf("\nAll frames sent successfully!\n");
}

int main()
{
    int n, window_size;
    int frames[MAX_FRAMES];

    printf("Sliding Window Protocol Simulation (Go-Back-N)\n");
    printf("Enter number of frames to send (max 50): ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX_FRAMES) {
        printf("Invalid number of frames.\n");
        return 0;
    }

    printf("Enter window size: ");
    scanf("%d", &window_size);

    if (window_size <= 0 || window_size > n) {
        printf("Invalid window size.\n");
        return 0;
    }

    for (int i = 0; i < n; i++)
        frames[i] = i;

    sender(frames, n, window_size);
    return 0;
}

Execution: In the terminal, save the program and compile/run it:
gcc slidingwindow.c -o slidingwindow\n./slidingwindow
Input: Example: number of frames = 8; window size = 3. Enter y when asked whether all frames were received correctly.
Output: Frames are sent in windows [0][1][2], [3][4][5] and [6][7]. The receiver displays ACK values 1 through 8. The program then displays All frames sent successfully!





PRACTICAL 9A – LEAKY BUCKET 
Aim: To simulate the Leaky Bucket and Token Bucket algorithms.
A. Leaky Bucket – leakybucket_271.c
#include <stdio.h>

int main()
{
    int bucket_size, rate, incoming, stored = 0, n;

    printf("Leaky Bucket Algorithm Simulation\n");
    printf("Enter bucket size (capacity): ");
    scanf("%d", &bucket_size);
    printf("Enter outgoing rate: ");
    scanf("%d", &rate);
    printf("Enter number of packets (time units): ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        printf("\nTime unit %d:\n", i + 1);
        printf("Enter number of incoming packets: ");
        scanf("%d", &incoming);

        if (incoming + stored > bucket_size) {
            printf("Overflow! Packets lost: %d\n",
                   incoming + stored - bucket_size);
            stored = bucket_size;
        } else {
            stored += incoming;
        }

        if (stored >= rate) {
            printf("Packets sent: %d\n", rate);
            stored -= rate;
        } else {
            printf("Packets sent: %d\n", stored);
            stored = 0;
        }

        printf("Packets remaining in bucket: %d\n", stored);
    }

    printf("\nDraining remaining packets...\n");
    while (stored > 0) {
        if (stored >= rate) {
            printf("Packets sent: %d\n", rate);
            stored -= rate;
        } else {
            printf("Packets sent: %d\n", stored);
            stored = 0;
        }
        printf("Packets left in bucket: %d\n", stored);
    }

    printf("Simulation complete.\n");
    return 0;
}

Execution: Save the program and execute:
gcc leakybucket_271.c -o leakybucket\n./leakybucket
Input: Example from the practical: bucket capacity = 10, outgoing rate = 4, time units = 5; incoming packets = 8, 3, 7, 2, 6.
Output: For each time unit, the program displays packets sent and packets remaining in the bucket. It reports overflow if incoming packets exceed the available capacity, then drains remaining packets.



PRACTICAL 9 B - TOKEN BUCKET ALGORITHMS

B. Token Bucket – tokenbucket_271.c

#include <stdio.h>

int main()
{
    int bucket_size, rate, tokens = 0, incoming, n;

    printf("Token Bucket Algorithm Simulation\n");
    printf("Enter bucket size (capacity): ");
    scanf("%d", &bucket_size);
    printf("Enter token generation rate: ");
    scanf("%d", &rate);
    printf("Enter number of packets (time units): ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        printf("\nTime unit %d:\n", i + 1);
        tokens += rate;
        if (tokens > bucket_size)
            tokens = bucket_size;

        printf("Enter number of packets to send: ");
        scanf("%d", &incoming);

        if (tokens >= incoming) {
            printf("Packets sent: %d\n", incoming);
            tokens -= incoming;
        } else {
            printf("Only %d tokens available, packets sent: %d, packets dropped: %d\n",
                   tokens, tokens, incoming - tokens);
            tokens = 0;
        }

        printf("Tokens left: %d\n", tokens);
    }

    printf("\nSimulation complete.\n");
    return 0;
}

Execution: Save the program and execute:
gcc tokenbucket_271.c -o tokenbucket\n./tokenbucket
Input: Example from the practical: bucket capacity = 10, token generation rate = 4, time units = 5; packets to send = 2, 6, 3, 8, 1.
Output: The program displays packets sent, packets dropped (if tokens are insufficient) and tokens left after each time unit.




PRACTICAL 10 – DISTANCE VECTOR ROUTING ALGORITHM

Aim: To implement the Distance Vector Routing algorithm and display the final routing table for each node.
Program – exp10_271.c
#include <stdio.h>
#define MAX_NODES 10
#define INF 9999

struct Node {
    int dist[MAX_NODES];
    int nextHop[MAX_NODES];
};

int main()
{
    int cost[MAX_NODES][MAX_NODES];
    struct Node rt[MAX_NODES];
    int nodes, i, j, k, updated;

    printf("Enter number of nodes: ");
    scanf("%d", &nodes);

    printf("Enter cost matrix (use 999 for no connection):\n");
    for (i = 0; i < nodes; i++) {
        for (j = 0; j < nodes; j++) {
            scanf("%d", &cost[i][j]);
            if (cost[i][j] == 999)
                cost[i][j] = INF;
        }
    }

    for (i = 0; i < nodes; i++) {
        for (j = 0; j < nodes; j++) {
            rt[i].dist[j] = cost[i][j];
            if (i == j)
                rt[i].nextHop[j] = i;
            else if (cost[i][j] < INF)
                rt[i].nextHop[j] = j;
            else
                rt[i].nextHop[j] = -1;
        }
    }

    do {
        updated = 0;
        for (i = 0; i < nodes; i++) {
            for (j = 0; j < nodes; j++) {
                for (k = 0; k < nodes; k++) {
                    if (cost[i][k] >= INF || rt[k].dist[j] >= INF)
                        continue;

                    int newDistance = cost[i][k] + rt[k].dist[j];
                    if (newDistance < rt[i].dist[j]) {
                        rt[i].dist[j] = newDistance;
                        rt[i].nextHop[j] = k;
                        updated = 1;
                    }
                }
            }
        }
    } while (updated);

    printf("\n========== FINAL ROUTING TABLES ==========\n");
    for (i = 0; i < nodes; i++) {
        printf("\nRouting Table for Node %d\n", i);
        printf("---------------------------------\n");
        printf("Destination\tNext Hop\tDistance\n");

        for (j = 0; j < nodes; j++) {
            printf("%d\t\t", j);
            if (rt[i].nextHop[j] == -1)
                printf("-\t\t");
            else
                printf("%d\t\t", rt[i].nextHop[j]);

            if (rt[i].dist[j] >= INF)
                printf("INF\n");
            else
                printf("%d\n", rt[i].dist[j]);
        }
    }
    return 0;
}

Execution: Save the program and compile/run it:
gcc exp10_271.c -o exp10_271\n./exp10_271
Input: Number of nodes = 3. Enter the cost matrix:
0 2 7\n2 0 1\n7 1 0
Output: The program displays the final routing table for Node 0, Node 1 and Node 2, showing Destination, Next Hop and Distance.
Expected final distances: Node 0: to 0 = 0, to 1 = 2, to 2 = 3. Node 1: to 0 = 2, to 1 = 0, to 2 = 1. Node 2: to 0 = 3, to 1 = 1, to 2 = 0.

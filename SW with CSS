<!DOCTYPE html>
<html>
<head>
    <title>Student Records</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #eef3f8;
            color: #2d3e50;
            padding: 30px;
        }
        .records {
            max-width: 520px;

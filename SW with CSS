            padding: 25px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 3px 12px #d1dce7;
        }
        h2 { color: #376b91; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th { background: #376b91; color: white; }
        th, td { padding: 10px; border: 1px solid #b9c8d5; text-align: left; }
        tr:nth-child(even) { background: #f0f5f9; }
    </style>
</head>
<body>
    <div class="records">
        <h2>Student Records</h2>
        <table>
            <tr><th>Name</th><th>Age</th></tr>
            <tbody id="result"></tbody>
        </table>
    </div>
    <script>
        fetch("data.json")
        .then(response => response.json())
        .then(data => {
            let output = "";
            data.forEach(student => {
                output += "<tr>";
                output += "<td>" + student.name + "</td>";
                output += "<td>" + student.age + "</td>";
                output += "</tr>";
            });
            document.getElementById("result").innerHTML = output;
        })
        .catch(error => {
            console.log("Error:", error);
        });
    </script>

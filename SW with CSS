Practical 5. Array Methods and Object Handling
Aim: To implement JavaScript array methods and object handling by developing a shopping cart total calculator with discount logic.
Complete HTML + CSS + JavaScript code
<!DOCTYPE html>
<html>
<head>
    <title>Shopping Cart</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            color: #27364a;
            padding: 25px;
        }
        .cart {
            max-width: 520px;
            margin: 20px auto;
            background: white;
            padding: 25px;
            border-radius: 10px;
            border-top: 5px solid #4776a8;
            box-shadow: 0 3px 12px #d6dee8;
        }
        h2 { color: #315f8d; }
        button {
            background: #315f8d; color: white; border: 0;
            padding: 10px 17px; border-radius: 5px;
        }
        #result { line-height: 1.7; margin-top: 15px; }
    </style>
</head>
<body>
    <div class="cart">
        <h2>Shopping Cart</h2>
        <button onclick="calculateBill()">Calculate Bill</button>
        <div id="result"></div>
    </div>
    <script>
        let cart = [
            { name: "Laptop", price: 50000, quantity: 1 },
            { name: "Mouse", price: 500, quantity: 2 },
            { name: "Keyboard", price: 1000, quantity: 1 }
        ];

        function calculateBill() {
            let total = cart.reduce((sum, item) => {
                return sum + (item.price * item.quantity);
            }, 0);

            let discount = 0;
            if (total >= 50000) {
                discount = total * 0.10;
            }
            else if (total >= 20000) {
                discount = total * 0.05;
            }

            let finalAmount = total - discount;
            let output = "<h3>Products:</h3>";

            cart.map(item => {
                output += item.name + " - ₹" + item.price +
                    " x " + item.quantity + "<br>";
            });

            output += "<br>Total: ₹" + total;
            output += "<br>Discount: ₹" + discount;
            output += "<br>Final Amount: ₹" + finalAmount;
            document.getElementById("result").innerHTML = output;
        }
    </script>
</body>
</html>




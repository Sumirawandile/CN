Practical 5: Array Methods and Object Handling

Aim: To implement JavaScript array methods and object handling by developing a shopping cart total calculator with discount logic.
<!DOCTYPE html>
<html>
<head>
    <title>Shopping Cart</title>
</head>
<body>
    <h2>Shopping Cart</h2>
    <button onclick="calculateBill()">Calculate Bill</button>
    <div id="result"></div>

    <script>
        let cart = [
            { name: "Laptop", price: 50000, quantity: 1 },
            { name: "Mouse", price: 500, quantity: 2 },
            { name: "Keyboard", price: 1000, quantity: 1 }
        ];

        function calculateBill() {
            let total = cart.reduce((sum, item) => {
                return sum + (item.price * item.quantity);
            }, 0);

            let discount = 0;

            if (total >= 50000) {
                discount = total * 0.10;
            }
            else if (total >= 20000) {
                discount = total * 0.05;
            }

            let finalAmount = total - discount;
            let output = "<h3>Products:</h3>";

            cart.map(item => {
                output += item.name + " - ₹" +
                    item.price + " x " + item.quantity + "<br>";
            });

            output += "<br>Total: ₹" + total;
            output += "<br>Discount: ₹" + discount;
            output += "<br>Final Amount: ₹" + finalAmount;

            document.getElementById("result").innerHTML = output;
        }
    </script>
</body>
</html>



Practical 6: String Functions and Regular Expressions

Aim: To use JavaScript string functions and regular expressions for email validation, data extraction and text analysis.
<!DOCTYPE html>
<html>
<head>
    <title>String and RegEx</title>
</head>
<body>
    <h2>String and RegEx Operations</h2>
    Enter Email:
    <input type="text" id="email">
    <br><br>
    Enter Text:
    <input type="text" id="text">
    <br><br>
    <button onclick="analyze()">Analyze</button>
    <h3 id="result"></h3>

    <script>
        function analyze() {
     
            let email = document.getElementById("email").value;
            let pattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            let emailResult;

            if (pattern.test(email)) {
                emailResult = "Valid Email";
            }
            else {
                emailResult = "Invalid Email";
            }

            let text = document.getElementById("text").value;
            let characters = text.length;
            let words = text.trim().split(/\s+/).length;

            let numbers = text.match(/\d+/g);

            if (numbers == null) {
                numbers = "No numbers found";
            }

            document.getElementById("result").innerHTML =
                "Email: " + emailResult +
                "<br>Characters: " + characters +
                "<br>Words: " + words +
                "<br>Numbers: " + numbers;
        }
    </script>
</body>
</html>



Practical 7: DOM Traversal and Manipulation

Aim: To perform DOM traversal and manipulation by developing a to-do list application with add, edit and delete operations.
<!DOCTYPE html>
<html>
<head>
    <title>To-Do List</title>
</head>
<body>
    <h2>To-Do List Application</h2>
    <input type="text" id="task" placeholder="Enter a task">
    <button onclick="addTask()">Add Task</button>
    <ul id="taskList"></ul>

    <script>
        function addTask() {
            let task = document.getElementById("task").value;

            if (task === "") {
                alert("Please enter a task");
                return;
            }

            let li = document.createElement("li");
            li.textContent = task;

            let editBtn = document.createElement("button");
            editBtn.textContent = "Edit";

            editBtn.onclick = function() {
                let newTask = prompt("Enter new task:", li.firstChild.textContent);

                if (newTask !== null && newTask.trim() !== "") {
                    li.firstChild.textContent = newTask;
                }
            };

            let deleteBtn = document.createElement("button");
            deleteBtn.textContent = "Delete";

            deleteBtn.onclick = function() {
                li.remove();
            };

            li.appendChild(editBtn);
            li.appendChild(deleteBtn);

            document.getElementById("taskList").appendChild(li);
            document.getElementById("task").value = "";
        }
    </script>
</body>
</html>



Practical 8: Form Handling and Validation using JavaScript Events

Aim: To access and validate form fields using JavaScript events by developing a gym admission form with live input validation.
<!DOCTYPE html>
<html>
<head>
    <title>Gym Admission Form</title>
</head>
<body>
    <h2>Gym Admission Form</h2>

    <form onsubmit="return validateForm()">
        Name:
        <input type="text" id="name" oninput="validateName()">
        <p id="nameMsg"></p>

        Age:
        <input type="number" id="age">
        <br><br>

        Email:
        <input type="text" id="email">
        <br><br>

        Phone:
        <input type="text" id="phone">
        <br><br>

        Membership:
        <select id="membership">
            <option value="">Select</option>
            <option value="Monthly">Monthly</option>
            <option value="Yearly">Yearly</option>
        </select>
        <br><br>

        <button type="submit">Submit</button>
    </form>

    <h3 id="result"></h3>

    <script>
        function validateName() {
            let name = document.getElementById("name").value;

            if (name === "") {
                document.getElementById("nameMsg").innerHTML = "Name is required";
            }
            else {
                document.getElementById("nameMsg").innerHTML = "Valid name";
            }
        }

        function validateForm() {
            let name = document.getElementById("name").value;
            let age = Number(document.getElementById("age").value);
            let email = document.getElementById("email").value;
            let phone = document.getElementById("phone").value;
            let membership = document.getElementById("membership").value;

            let emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            let phonePattern = /^[0-9]{10}$/;

            if (name.trim() === "") {
                alert("Enter name");
                return false;
            }

            if (age < 18 || age > 60 ||
                document.getElementById("age").value === "") {
                alert("Invalid age");
                return false;
            }

            if (!emailPattern.test(email)) {
                alert("Invalid email");
                return false;
            }

            if (!phonePattern.test(phone)) {
                alert("Invalid phone number");
                return false;
            }

            if (membership === "") {
                alert("Select membership");
                return false;
            }

            document.getElementById("result").innerHTML =
                "Admission Successful! Welcome " + name;

            return false;
        }
    </script>
</body>
</html>



Practical 9: Local Storage and Session Storage

Aim: To implement localStorage and sessionStorage in JavaScript to save user preferences such as website themes.
<!DOCTYPE html>
<html>
<head>
    <title>Theme Preference</title>
</head>
<body>
    <h2>Theme Preference</h2>

    <button onclick="changeTheme('light')">Light Mode</button>
    <button onclick="changeTheme('dark')">Dark Mode</button>

    <script>
        function changeTheme(theme) {
            localStorage.setItem("theme", theme);

            if (theme === "dark") {
                document.body.style.backgroundColor = "black";
                document.body.style.color = "white";
            }
            else {
                document.body.style.backgroundColor = "white";
                document.body.style.color = "black";
            }
        }

        window.onload = function() {
            let savedTheme = localStorage.getItem("theme");

            if (savedTheme !== null) {
                changeTheme(savedTheme);
            }
        };
    </script>
</body>
</html>

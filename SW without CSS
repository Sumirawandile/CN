Practical 3: Control Structures and Form Validation

Aim: To implement JavaScript control structures and form validation by creating a student grading system based on user-entered marks.
<!DOCTYPE html>
<html>
<head>
    <title>Grading System</title>
</head>
<body>
    <h2>Student Grading System</h2>
    Enter Marks:
    <input type="number" id="marks">
    <button onclick="calculateGrade()">Check Grade</button>
    <h3 id="result"></h3>

    <script>
        function calculateGrade() {
            let marks = Number(document.getElementById("marks").value);

            if (document.getElementById("marks").value === "") {
                document.getElementById("result").innerHTML = "Please enter marks";
            }
            else if (marks < 0 || marks > 100) {
                document.getElementById("result").innerHTML = "Invalid marks";
            }
            else if (marks >= 90) {
                document.getElementById("result").innerHTML = "Grade A+";
            }
            else if (marks >= 80) {
                document.getElementById("result").innerHTML = "Grade A";
            }
            else if (marks >= 70) {
                document.getElementById("result").innerHTML = "Grade B";
            }
            else if (marks >= 60) {
                document.getElementById("result").innerHTML = "Grade C";
            }
            else if (marks >= 40) {
                document.getElementById("result").innerHTML = "Grade D";
            }
            else {
                document.getElementById("result").innerHTML = "Fail";
            }
        }
    </script>
</body>
</html>




Practical 10: Fetch API and jQuery

Aim: To load and display JSON data using Fetch API and jQuery, and dynamically display the retrieved data in an HTML table.
JSON file (data.json)
[
    {
        "name": "Sumira",
        "age": 20
    },
    {
        "name": "Rahul",
        "age": 21
    },
    {
        "name": "Amit",
        "age": 22
    }
]
HTML file using Fetch API (index.html)
<!DOCTYPE html>
<html>
<head>
    <title>Student Records</title>
</head>
<body>
    <h2>Student Records</h2>

    <table border="1">
        <tr>
            <th>Name</th>
            <th>Age</th>
        </tr>
        <tbody id="result"></tbody>
    </table>

    <script>
        fetch("data.json")
        .then(response => response.json())
        .then(data => {
            let output = "";

            data.forEach(student => {
                output += "<tr>";
                output += "<td>" + student.name + "</td>";
                output += "<td>" + student.age + "</td>";
                output += "</tr>";
            });

            document.getElementById("result").innerHTML = output;
        })
        .catch(error => {
            console.log("Error:", error);
        });
    </script>
</body>
</html>
